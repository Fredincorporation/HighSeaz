# Robinhood Chain testnet deploy config (forge). Copy to .env and fill. NEVER commit .env.
# Deployer/broadcast key (granted DEFAULT_ADMIN by Deploy.s.sol; keep it safe).
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
PRIVATE_KEY=

# Optional wiring the deploy script reads (default to the deployer if unset):
# The authoritative server hot wallet (granted SERVER_ROLE; funds bounty float).
# SERVER_ADDRESS=0x...
# Auction fee recipient + ship-store revenue wallet.
# FEE_RECIPIENT=0x...
# REVENUE_WALLET=0x...
# Live testnet USDG (Paxos) address. If UNSET, Deploy.s.sol deploys MockUSDG and
# funds the server so the bounty demo works out of the box.
# USDG_ADDRESS=0x...

# Etherscan-style verification (after --broadcast --verify).
RH_ETHERSCAN_API_KEY=
RH_VERIFY_URL=
