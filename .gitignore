# Secrets / local env — NEVER commit. The server/.env and root .env.local can
# hold the SERVER_ROLE / deployer private key and the Supabase service-role key.
# Keep them untracked. (.env.* also covers .env.local; the ! lines re-allow the
# committed .env.example templates.)
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# Node / build output
node_modules/
dist/
build/
.next/
out/

# TypeScript incremental build cache
*.tsbuildinfo

# Vercel (project link / local dev metadata — never commit)
.vercel/

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/
broadcast/
coverage/

# Server runtime state (world persistence snapshot — regenerated, not source)
server/world-state.json

# Logs & editor / OS cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db
