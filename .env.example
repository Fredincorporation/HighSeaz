# HighSeaz browser (Next.js) config. Only NEXT_PUBLIC_* reach the client bundle.
# Copy to .env.local. These are NON-SECRET public values (contract addresses,
# RPC URL, Supabase project URL + anon key) safe to expose to the browser. Players
# sign with their OWN injected wallet (MetaMask / Rabby) for on-chain writes, and
# that wallet is exchanged for a Supabase auth session via Web3 sign-in. No private
# key ever lives here.

# Authoritative game server websocket.
NEXT_PUBLIC_WS_URL=ws://localhost:9000

# Supabase (client side): used for the Web3 auth session (signInWithWeb3) and the
# `players` wallet-registration table that gates the intro video. The project URL
# and ANON key are PUBLIC (RLS-protected) and safe in the bundle. The service_role
# key is SERVER-ONLY (server/.env) — never put it in a NEXT_PUBLIC_* var.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settlement contracts this deployment points at (from deployments/addresses.json).
NEXT_PUBLIC_RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_USDG_ADDRESS=
NEXT_PUBLIC_BOUNTY_ESCROW_ADDRESS=
NEXT_PUBLIC_SHIP_STORE_ADDRESS=
NEXT_PUBLIC_SHIP_NFT_ADDRESS=
NEXT_PUBLIC_AUCTION_HOUSE_ADDRESS=
NEXT_PUBLIC_ALLIANCE_REGISTRY_ADDRESS=

# Sea shanty playlist root (public, non-secret). The 13 tracks stream from this R2
# prefix via a MediaElementSource — never PCM-decoded, so they don't hit memory.
# Leave blank to use the built-in default (the highseaz bucket public dev URL,
# .../audio/shanties). Override only to point at another bucket/CDN.
NEXT_PUBLIC_SHANTY_BASE=

# Serve the WHOLE public/ asset tree (models, forts, islands, vfx, textures, ui,
# lut, audio) from Cloudflare R2 instead of Next's public/. Leave blank to keep
# loading them locally from public/ (offline dev fallback); set it to the bucket's
# public URL to pull everything from the CDN. Do this AFTER `npm run assets:upload`.
# (Same bucket the shanties already use — the public dev URL is rate-limited, so
#  for the demo prefer a custom domain bound to the R2 bucket.)
# NEXT_PUBLIC_ASSET_BASE=https://pub-4399d522d0d140df9830051a19f2e30f.r2.dev
NEXT_PUBLIC_ASSET_BASE=

# --- Uploader credentials (NOT NEXT_PUBLIC — CLI only, never in the bundle) ---
# Used by scripts/upload-to-r2.mjs. R2 is S3-compatible, so these are an R2
# "Object Access" API token's Access Key ID + Secret, plus the bucket + account.
# NEVER commit them; put them in .env.local / your shell env only.
# R2_ACCOUNT_ID=
# R2_BUCKET=highseaz-assets
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# (endpoint is derived as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com unless R2_ENDPOINT is set)
