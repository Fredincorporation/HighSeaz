# HighSeaz server config (the authoritative node + on-chain relayer). Copy to .env.
# Transport
PORT=9000

# On-chain RELAYER. With these unset the relayer runs disabled and gameplay is
# fully playable (chain never blocks play). Set all three to settle USDG bounties.
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
SERVER_PRIVATE_KEY=
USDG_ADDRESS=
BOUNTY_ESCROW_ADDRESS=

# Other settlement contracts (fill from deployments/addresses.json after deploy).
SHIP_NFT_ADDRESS=
LOOT_MINT_ADDRESS=
ALLIANCE_REGISTRY_ADDRESS=
AUCTION_HOUSE_ADDRESS=
SHIP_STORE_ADDRESS=

# Off-chain world-state persistence (#163) via Supabase Postgres. Only the server
# reads these; the client never touches Supabase. The SERVICE-ROLE KEY IS SECRET —
# put it only in the untracked .env, never commit it. Leave either var blank to
# disable Supabase and fall back to the local world-state.json file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WORLD_TABLE=world_snapshots

